# Copy this file to .env.local (git-ignored). Everything here is optional.

# Every photo is saved on this computer in photos/ (git-ignored), even without internet.
# Set to false to keep no local copies, for example if your event's privacy rules require it.
SAVE_PHOTOS_LOCALLY=true

# Photo QR codes: fill in your Supabase project values to upload photos and get 24-hour download links.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# The service_role key. Keep it secret: it is only read by the dev server, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# A PRIVATE Storage bucket (Storage -> New bucket, leave "Public" off)
SUPABASE_BUCKET=photos
